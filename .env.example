# ==============================================================================
# Robot Connectivity (Boston Dynamics Spot)
# ==============================================================================
# The IP address of the Spot robot (default is usually 192.168.50.3 or 192.168.10.3)
IP_ADRESSE=192.168.50.3

# Spot API Credentials
SPOT_USERNAME=spot
SPOT_PASSWORD=the_password

# ==============================================================================
# Streaming Web Server / UI Configuration
# ==============================================================================
# Backend Flask API configuration
FLASK_HOST=
FLASK_PORT=5000

# Frontend Web UI configuration
FRONTEND_HOST=
FRONTEND_PORT=8000
