# Use NVIDIA L4T base image for JetPack 6 (L4T R36.x, Ubuntu 22.04)
# r36.2.0 is the latest l4t-base tag on NGC; works on JetPack 6.2.2 hosts
# via the NVIDIA container runtime mount plugin
FROM nvcr.io/nvidia/l4t-base:r36.2.0

# Set noninteractive mode for apt
ENV DEBIAN_FRONTEND=noninteractive

# Install Python 3.10 (default on Ubuntu 22.04) and system deps
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    python3.10 python3.10-venv python3.10-dev \
    curl libgl1 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Ensure python3 points to python3.10
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Set work directory
WORKDIR /app

# Remove distutils-installed blinker (if exists)
RUN rm -rf /usr/lib/python3/dist-packages/blinker* 2>/dev/null || true

# Copy dependency manifests first for better layer caching
COPY pyproject.toml uv.lock /app/

# Install only the default (inference) dependencies from the lockfile
RUN uv sync --frozen --no-dev --no-group training

# Copy only files needed for inference
COPY main.py /app/
COPY cfg/ /app/cfg/
COPY engine/ /app/engine/
COPY jester/ /app/jester/
COPY utils/ /app/utils/
COPY actions/ /app/actions/
COPY models/ /app/models/
COPY data_loader/ /app/data_loader/
COPY plot/ /app/plot/
COPY scripts/ /app/scripts/

# run the app
CMD ["uv", "run", "python3", "main.py"]
